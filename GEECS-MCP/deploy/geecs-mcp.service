# GEECS MCP server — central HTTP deployment, systemd unit TEMPLATE.
#
# Do not copy this file to /etc/systemd/system by hand. Render it from the
# host's site.env with `deploy/render_units.sh` (or `deploy/bootstrap_host.sh`)
# — see docs/platform/site_profile.md. @PLACEHOLDER@ holes are filled at render
# time (paths + identity); ${VARIABLE} values come from site.env at start via
# EnvironmentFile=.
#
# The venv is NON-EDITABLE by design: the code is baked from the worker's
# clone (qs-checkout) into @CHECKOUT_ROOT@/geecs-mcp-venv, so a pull in the
# clone never mutates code under the running server. Update ritual
# (DEPLOYMENT.md): pull, re-run the pip install, restart.
#
# The server is a thin HTTP client of the web scanner, the Data Portal and
# the logbook (GEECS-MCP/DESIGN.md): it imports nothing from the repo at
# runtime, so the venv holds fastmcp + httpx + pillow and no extra.

[Unit]
Description=GEECS MCP server (an agent's client of the scanner, portal and logbook)
# Ordering only, when they share this host: the server starts (and every
# verb answers service_unreachable) without them.
After=network-online.target geecs-scanner.service geecs-data-portal.service geecs-logbook.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
# The server reads only [mcp] scanner_url / portal_url / logbook_url from the
# service account's config.ini under $HOME.
Environment=HOME=@SERVICE_HOME@
EnvironmentFile=@SITE_ENV@
ExecStart=@CHECKOUT_ROOT@/geecs-mcp-venv/bin/python -m geecs_mcp --transport http --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5
# The MCP shares the box with the production manager/gateway/Tiled —
# cap it so even a pathological failure cannot starve them. An HTTP client
# with no analysis in process needs little; the thumbnail decode is capped
# at 80 Mpx.
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
