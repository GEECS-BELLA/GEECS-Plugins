{
  "components": {
    "schemas": {
      "Colour": {
        "description": "A crosshair colour, 0..255 a channel (the IOC stores it per overlay).",
        "properties": {
          "b": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "B",
            "type": "integer"
          },
          "g": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "G",
            "type": "integer"
          },
          "r": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "R",
            "type": "integer"
          }
        },
        "required": [
          "r",
          "g",
          "b"
        ],
        "title": "Colour",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MotorPut": {
        "description": "One allow-listed write: an axis of the device, a record field and its value.",
        "properties": {
          "axis": {
            "title": "Axis",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "axis",
          "field",
          "value"
        ],
        "title": "MotorPut",
        "type": "object"
      },
      "Override": {
        "description": "The stuck-lock override: who is releasing it (the surfaces carry no user identity).",
        "properties": {
          "operator": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Operator",
            "type": "string"
          }
        },
        "required": [
          "operator"
        ],
        "title": "Override",
        "type": "object"
      },
      "Point": {
        "description": "A point in image pixels.",
        "properties": {
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "title": "Point",
        "type": "object"
      },
      "PutRequest": {
        "description": "One allow-listed write: a PV suffix under the camera's prefix and its value.",
        "properties": {
          "pv": {
            "title": "Pv",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "pv",
          "value"
        ],
        "title": "PutRequest",
        "type": "object"
      },
      "ScopePut": {
        "description": "One allow-listed setting: a PV suffix under the scope's prefix and its value.",
        "properties": {
          "pv": {
            "title": "Pv",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "pv",
          "value"
        ],
        "title": "ScopePut",
        "type": "object"
      },
      "SupplyPut": {
        "description": "One action: its name (``current``, ``output``, ``reset`` …) and its value.",
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "action",
          "value"
        ],
        "title": "SupplyPut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
