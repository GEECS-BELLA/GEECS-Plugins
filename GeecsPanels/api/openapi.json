    "/camera/{name}/unlock": {
      "post": {
        "description": "Release a stuck run lock (a killed worker), naming who did, in the log.\n\nWrites ``RUN:Lock`` 0 only — never the writer or the driver — so\nmisjudging a live run as stuck cannot end its stack file; at worst\nit reopens, for that run, the race the lock closes.",
        "operationId": "post_camera_name_unlock",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
