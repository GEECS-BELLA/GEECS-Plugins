# GeecsCanopy exercise, lane C1: the .env beside compose.yaml. Placeholders
# only; the live file (with generated secrets) lives in the runtime directory,
# never in a repository. Every value must be a single line.
IMAGE=ghcr.io/slaclab/canopy:0a5ee23
API_PORT=8000

POSTGRES_USER=canopy
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=canopy
REDIS_PASSWORD=<redis-password>
CANOPY_DATABASE_URL=postgresql+asyncpg://canopy:<postgres-password>@postgres:5432/canopy
CANOPY_REDIS_URL=redis://:<redis-password>@redis:6379/0

# Env-layer keys (checked before the database registry). Mint every other key
# with: docker compose run --rm api python scripts/create_key.py "<app>" -r [-w]
CANOPY_API_KEYS=<display-read-token>:read@*,<operator-write-token>:read+write@*,<ops-admin-token>:admin@*

# Without this Canopy serves synthetic sine waves and still passes /health.
CANOPY_EPICS__BACKEND=epics
CANOPY_LOG_LEVEL=INFO

# Docker Desktop (bridge network): one host:port per IOC, through the host gateway.
# On a Linux services box with network_mode: host, use the facility's CA list.
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_ADDR_LIST=host.docker.internal:<camera-ca-port> host.docker.internal:<supply1-ca-port> host.docker.internal:<supply2-ca-port> host.docker.internal:<motor-ca-port>
EPICS_CA_MAX_ARRAY_BYTES=20000000
# pvAccess by TCP name server: UDP search replies through Docker Desktop's proxy are not usable.
EPICS_PVA_AUTO_ADDR_LIST=NO
EPICS_PVA_NAME_SERVERS=host.docker.internal:<camera-pva-tcp-port>
