{
  "schema_version": 1,
  "template": "easydriver",
  "kind": "setpoint_device",
  "description": "A CAEN Easy-Driver supply behind StreamDevice (geecs-epics services/eztest1, easydriver.template): current setpoint, output, one external interlock.",
  "roles": [
    {"name": "current_sp", "suffix": "current:SP", "type": "setpoint", "label": "current setpoint", "writable": true, "readback": "current", "fields": ["DRVH", "DRVL", "HIHI", "LOLO", "HHSV", "LLSV", "EGU", "PREC", "SEVR", "STAT"], "archive": true},
    {"name": "current", "suffix": "current", "type": "readback", "label": "current", "fields": ["EGU", "PREC", "SEVR", "STAT"], "archive": true},
    {"name": "voltage", "suffix": "voltage", "type": "readback", "label": "voltage", "fields": ["EGU", "PREC"], "archive": true},
    {"name": "output_sp", "suffix": "enable_output:SP", "type": "bit", "label": "output", "writable": true, "readback": "output", "confirm": "hazard", "fields": ["SEVR", "STAT"], "archive": true},
    {"name": "output", "suffix": "enable_output", "type": "bit", "label": "output on", "archive": true},
    {"name": "reset", "suffix": "reset:SP", "type": "command", "label": "reset faults", "writable": true},
    {"name": "fault", "suffix": "fault", "type": "bit", "label": "fault", "fault": true, "archive": true},
    {"name": "interlock", "suffix": "interlock", "type": "bit", "label": "interlock", "fault": true, "archive": true}
  ],
  "actions": {
    "current": {"label": "current", "roles": ["current_sp"]},
    "output": {"label": "output", "roles": ["output_sp"]},
    "reset": {"label": "reset", "roles": ["reset"]}
  }
}
