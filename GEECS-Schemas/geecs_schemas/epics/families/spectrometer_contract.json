{
  "schema_version": 1,
  "template": "spectrometer_contract",
  "kind": "array_detector",
  "description": "geecs-epics' spectrometer contract: vendor-neutral settings at the device prefix, aliased by each spectrometer driver (ADSpecfirm first), with the standard chain behind them (ARR, PROC, STAT1); the raw (ARR) and the background-subtracted (PROC:ARR) spectrum are drawn over Wavelength_RBV.",
  "roles": [
    {"name": "manufacturer", "suffix": "Manufacturer_RBV", "type": "readback", "label": "manufacturer", "text": "string", "level": "expert"},
    {"name": "model", "suffix": "Model_RBV", "type": "readback", "label": "model", "text": "string"},
    {"name": "serial", "suffix": "SerialNumber_RBV", "type": "readback", "label": "serial number", "text": "string", "level": "expert"},
    {"name": "firmware", "suffix": "FirmwareVersion_RBV", "type": "readback", "label": "firmware", "text": "string", "level": "expert"},
    {"name": "sensor", "suffix": "Sensor_RBV", "type": "readback", "label": "sensor", "text": "char_array", "level": "expert"},
    {"name": "board_serial", "suffix": "BoardSerial_RBV", "type": "readback", "label": "board serial", "text": "string", "level": "expert"},
    {"name": "spectrometer_serial", "suffix": "SpectrometerSerial_RBV", "type": "readback", "label": "spectrometer serial", "text": "string", "level": "expert"},
    {"name": "connected", "suffix": "Connected_RBV", "type": "enum", "label": "connected", "archive": true},
    {"name": "state", "suffix": "DetectorState_RBV", "type": "enum", "label": "state"},
    {"name": "status", "suffix": "StatusMessage_RBV", "type": "readback", "label": "status", "text": "char_array"},
    {"name": "last_error", "suffix": "LastError_RBV", "type": "readback", "label": "last error", "text": "char_array"},
    {"name": "temperature", "suffix": "TemperatureActual", "type": "readback", "label": "temperature", "units": "°C", "archive": true},
    {"name": "acquire", "suffix": "Acquire_RBV", "type": "enum", "label": "acquire", "writable": true, "write": "Acquire", "settled_by": "acquire", "integer": true, "limits": [0, 1]},
    {"name": "image_mode", "suffix": "ImageMode_RBV", "type": "enum", "label": "image mode", "writable": true, "write": "ImageMode", "archive": true},
    {"name": "num_images", "suffix": "NumImages_RBV", "type": "setpoint", "label": "spectra per acquire", "writable": true, "write": "NumImages", "integer": true, "limits": [1, 1000000], "archive": true},
    {"name": "integration_time", "suffix": "IntegrationTime_RBV", "type": "setpoint", "label": "integration time", "writable": true, "write": "IntegrationTime", "units": "s", "limits": [0, 65], "archive": true},
    {"name": "averages", "suffix": "Averages_RBV", "type": "setpoint", "label": "averages", "writable": true, "write": "Averages", "integer": true, "limits": [1, 10000], "archive": true},
    {"name": "acquire_period", "suffix": "AcquirePeriod_RBV", "type": "setpoint", "label": "acquire period", "writable": true, "write": "AcquirePeriod", "units": "s", "limits": [0, 3600], "archive": true},
    {"name": "trigger_mode", "suffix": "TriggerMode_RBV", "type": "enum", "label": "trigger mode", "writable": true, "write": "TriggerMode", "archive": true},
    {"name": "trigger_slope", "suffix": "TriggerSlope_RBV", "type": "enum", "label": "trigger slope", "writable": true, "write": "TriggerSlope", "archive": true},
    {"name": "raw_mode", "suffix": "RawMode_RBV", "type": "enum", "label": "spectrum kind", "writable": true, "write": "RawMode", "archive": true},
    {"name": "count", "suffix": "ArrayCounter_RBV", "type": "counter", "label": "spectra taken", "level": "expert"},
    {"name": "count_in_acquire", "suffix": "NumImagesCounter_RBV", "type": "counter", "label": "spectra this acquire", "level": "expert"},
    {"name": "pixels", "suffix": "Pixels_RBV", "type": "readback", "label": "pixels", "level": "expert"},
    {"name": "direction", "suffix": "Direction_RBV", "type": "enum", "label": "stream order", "level": "expert"},
    {"name": "level_max", "suffix": "LevelMax_RBV", "type": "readback", "label": "peak count", "units": "counts"},
    {"name": "level_percent", "suffix": "LevelPercent_RBV", "type": "readback", "label": "peak of full scale", "units": "%"},
    {"name": "saturated", "suffix": "Saturated_RBV", "type": "enum", "label": "saturated"},
    {"name": "board_time", "suffix": "BoardTime_RBV", "type": "readback", "label": "board clock", "units": "s", "level": "expert"},
    {"name": "min_integration", "suffix": "MinIntegration_RBV", "type": "readback", "label": "shortest integration", "units": "s", "level": "expert"},
    {"name": "stored_integration", "suffix": "StoredIntegration_RBV", "type": "readback", "label": "stored integration time", "units": "s", "level": "expert"},
    {"name": "stored_averages", "suffix": "StoredAverages_RBV", "type": "readback", "label": "stored averages", "level": "expert"},
    {"name": "board_trigger", "suffix": "BoardTrigger_RBV", "type": "enum", "label": "board trigger mode", "level": "expert"},
    {"name": "fit0", "suffix": "Fit0_RBV", "type": "readback", "label": "wavelength fit c0", "units": "nm", "level": "expert"},
    {"name": "fit1", "suffix": "Fit1_RBV", "type": "readback", "label": "wavelength fit c1", "level": "expert"},
    {"name": "fit2", "suffix": "Fit2_RBV", "type": "readback", "label": "wavelength fit c2", "level": "expert"},
    {"name": "fit3", "suffix": "Fit3_RBV", "type": "readback", "label": "wavelength fit c3", "level": "expert"},
    {"name": "fit4", "suffix": "Fit4_RBV", "type": "readback", "label": "wavelength fit c4", "level": "expert"},
    {"name": "arr_counter", "suffix": "ARR:ArrayCounter_RBV", "type": "counter", "label": "spectra published", "level": "expert"},
    {"name": "arr_uid", "suffix": "ARR:UniqueId_RBV", "type": "readback", "label": "spectrum id", "level": "expert"},
    {"name": "arr_pixels", "suffix": "ARR:ArraySize0_RBV", "type": "readback", "label": "spectrum length", "read": "on_request", "level": "expert"},
    {"name": "spectrum", "suffix": "ARR:ArrayData", "type": "array", "label": "raw spectrum", "units": "counts", "fresh_by": "arr_counter"},
    {"name": "proc_counter", "suffix": "PROC:ARR:ArrayCounter_RBV", "type": "counter", "label": "processed spectra published", "level": "expert"},
    {"name": "processed", "suffix": "PROC:ARR:ArrayData", "type": "array", "label": "processed spectrum", "units": "counts", "fresh_by": "proc_counter"},
    {"name": "wavelength", "suffix": "Wavelength_RBV", "type": "array", "label": "wavelength", "units": "nm", "axis_of": ["spectrum", "processed"]},
    {"name": "background_save", "suffix": "PROC:SaveBackground", "type": "command", "label": "Save background", "writable": true},
    {"name": "background_enable", "suffix": "PROC:EnableBackground_RBV", "type": "enum", "label": "subtract background", "writable": true, "write": "PROC:EnableBackground", "archive": true},
    {"name": "background_valid", "suffix": "PROC:ValidBackground_RBV", "type": "enum", "label": "background held"},
    {"name": "compute_statistics", "suffix": "STAT1:ComputeStatistics", "type": "bit", "label": "statistics computed", "level": "expert"},
    {"name": "compute_centroid", "suffix": "STAT1:ComputeCentroid", "type": "bit", "label": "centroid computed", "level": "expert"},
    {"name": "stat_counter", "suffix": "STAT1:ArrayCounter_RBV", "type": "counter", "label": "statistics spectra", "level": "expert"},
    {"name": "total", "suffix": "STAT1:Total_RBV", "type": "readback", "label": "integral", "units": "counts", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "max", "suffix": "STAT1:MaxValue_RBV", "type": "readback", "label": "peak", "units": "counts", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "min", "suffix": "STAT1:MinValue_RBV", "type": "readback", "label": "minimum", "units": "counts", "level": "expert", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "mean", "suffix": "STAT1:MeanValue_RBV", "type": "readback", "label": "mean", "units": "counts", "level": "expert", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "sigma", "suffix": "STAT1:Sigma_RBV", "type": "readback", "label": "sigma", "units": "counts", "level": "expert", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "peak_index", "suffix": "STAT1:MaxX_RBV", "type": "readback", "label": "peak index", "units": "px", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "centroid_index", "suffix": "STAT1:CentroidX_RBV", "type": "readback", "label": "centroid index", "units": "px", "fresh_by": "stat_counter", "computed_by": "compute_centroid"},
    {"name": "width_index", "suffix": "STAT1:SigmaX_RBV", "type": "readback", "label": "width index", "units": "px", "fresh_by": "stat_counter", "computed_by": "compute_centroid"}
  ],
  "panel": {
    "rail": [
      {"title": "Acquisition", "roles": ["acquire", "image_mode", "num_images", "integration_time", "averages", "acquire_period", "raw_mode"]},
      {"title": "Trigger", "roles": ["trigger_mode", "trigger_slope"]},
      {"title": "Background", "roles": ["background_save", "background_enable"]}
    ],
    "readings": ["state", "count", "level_max", "level_percent", "saturated", "background_valid", "total", "peak_index", "centroid_index", "width_index", "temperature", "last_error"],
    "buttons": {"acquire": ["Stop", "Start"]},
    "show_while": {"processed": "background_enable"}
  }
}
