{
  "schema_version": 1,
  "template": "motor_record",
  "kind": "epics_motor",
  "description": "The EPICS motor record (epics-modules/motor), one per axis: the fields every motor driver fills.",
  "per_axis": true,
  "roles": [
    {"name": "desc", "suffix": ".DESC", "type": "readback", "label": "description", "text": "string"},
    {"name": "egu", "suffix": ".EGU", "type": "readback", "label": "units", "text": "string", "level": "expert"},
    {"name": "prec", "suffix": ".PREC", "type": "readback", "label": "precision", "level": "expert"},
    {"name": "rbv", "suffix": ".RBV", "type": "readback", "label": "position", "archive": true},
    {"name": "val", "suffix": ".VAL", "type": "setpoint", "label": "target", "writable": true, "readback": "rbv", "archive": true, "settled_by": "dmov"},
    {"name": "dmov", "suffix": ".DMOV", "type": "bit", "label": "done moving", "archive": true},
    {"name": "movn", "suffix": ".MOVN", "type": "bit", "label": "moving"},
    {"name": "hlm", "suffix": ".HLM", "type": "readback", "label": "high soft limit"},
    {"name": "llm", "suffix": ".LLM", "type": "readback", "label": "low soft limit"},
    {"name": "hls", "suffix": ".HLS", "type": "bit", "label": "high limit switch", "archive": true},
    {"name": "lls", "suffix": ".LLS", "type": "bit", "label": "low limit switch", "archive": true},
    {"name": "lvio", "suffix": ".LVIO", "type": "bit", "label": "target outside the soft limits"},
    {"name": "velo", "suffix": ".VELO", "type": "setpoint", "label": "velocity", "writable": true},
    {"name": "vmax", "suffix": ".VMAX", "type": "readback", "label": "maximum velocity", "level": "expert"},
    {"name": "vbas", "suffix": ".VBAS", "type": "readback", "label": "base velocity", "level": "expert"},
    {"name": "accl", "suffix": ".ACCL", "type": "readback", "label": "acceleration time", "units": "s", "level": "expert"},
    {"name": "rdbd", "suffix": ".RDBD", "type": "readback", "label": "retry deadband", "level": "expert"},
    {"name": "twv", "suffix": ".TWV", "type": "setpoint", "label": "tweak step", "writable": true},
    {"name": "msta", "suffix": ".MSTA", "type": "readback", "label": "status word", "level": "expert"},
    {"name": "sevr", "suffix": ".SEVR", "type": "enum", "label": "alarm severity", "level": "expert"},
    {"name": "stat", "suffix": ".STAT", "type": "enum", "label": "alarm status", "level": "expert"},
    {"name": "set", "suffix": ".SET", "type": "enum", "label": "calibration mode", "level": "expert"},
    {"name": "spmg", "suffix": ".SPMG", "type": "enum", "label": "stop / pause / move / go"},
    {"name": "off", "suffix": ".OFF", "type": "readback", "label": "user offset", "level": "expert"},
    {"name": "twf", "suffix": ".TWF", "type": "command", "label": "tweak forward", "writable": true, "settled_by": "dmov"},
    {"name": "twr", "suffix": ".TWR", "type": "command", "label": "tweak reverse", "writable": true, "settled_by": "dmov"},
    {"name": "stop", "suffix": ".STOP", "type": "command", "label": "stop", "writable": true},
    {"name": "homf", "suffix": ".HOMF", "type": "command", "label": "home forward", "writable": true, "confirm": "hazard", "settled_by": "dmov"},
    {"name": "homr", "suffix": ".HOMR", "type": "command", "label": "home reverse", "writable": true, "confirm": "hazard", "settled_by": "dmov"}
  ],
  "actions": {
    "move": {"label": "move", "roles": ["val"], "requires": ["stop"]},
    "tweak": {"label": "tweak", "roles": ["twv", "twf", "twr"], "requires": ["stop"]},
    "stop": {"label": "stop", "roles": ["stop"]},
    "home": {"label": "home", "roles": ["homf", "homr"], "requires": ["stop"]},
    "velocity": {"label": "velocity", "roles": ["velo"]}
  }
}
