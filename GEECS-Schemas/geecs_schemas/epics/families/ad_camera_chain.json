{
  "schema_version": 1,
  "template": "ad_camera_chain",
  "kind": "aravis_camera",
  "description": "The areaDetector camera chain every camera IOC runs (geecs-epics runbook, 'Display and analysis chain'): cam1, STAT, STAT0, ROI1, PROC1, TRANS1, OVER1, MJPG1, HDF1 and the run lock.",
  "roles": [
    {"name": "state", "suffix": "cam1:DetectorState_RBV", "type": "enum", "label": "detector"},
    {"name": "rate", "suffix": "cam1:ArrayRate_RBV", "type": "readback", "label": "frame rate", "units": "Hz"},
    {"name": "exposure", "suffix": "cam1:AcquireTime_RBV", "type": "setpoint", "label": "exposure", "writable": true, "write": "cam1:AcquireTime", "units": "s", "limits": [0, 60], "locked": true, "archive": true},
    {"name": "pixel_format", "suffix": "cam1:PixelFormat_RBV", "type": "enum", "label": "pixel format", "archive": true},
    {"name": "cx", "suffix": "STAT:CentroidX_RBV", "type": "readback", "label": "centroid x", "fresh_by": "stat_counter", "computed_by": "compute_centroid", "units": "px"},
    {"name": "cy", "suffix": "STAT:CentroidY_RBV", "type": "readback", "label": "centroid y", "fresh_by": "stat_counter", "computed_by": "compute_centroid", "units": "px"},
    {"name": "sx", "suffix": "STAT:SigmaX_RBV", "type": "readback", "label": "sigma x", "fresh_by": "stat_counter", "computed_by": "compute_centroid", "units": "px"},
    {"name": "sy", "suffix": "STAT:SigmaY_RBV", "type": "readback", "label": "sigma y", "fresh_by": "stat_counter", "computed_by": "compute_centroid", "units": "px"},
    {"name": "max", "suffix": "STAT:MaxValue_RBV", "type": "readback", "label": "max", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "mean", "suffix": "STAT:MeanValue_RBV", "type": "readback", "label": "mean", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "total", "suffix": "STAT:Total_RBV", "type": "readback", "label": "total", "fresh_by": "stat_counter", "computed_by": "compute_statistics"},
    {"name": "raw_max", "suffix": "STAT0:MaxValue_RBV", "type": "readback", "label": "raw max", "fresh_by": "stat0_counter", "computed_by": "raw_compute_statistics"},
    {"name": "compute_centroid", "suffix": "STAT:ComputeCentroid", "type": "bit", "label": "centroid computed", "level": "expert"},
    {"name": "compute_statistics", "suffix": "STAT:ComputeStatistics", "type": "bit", "label": "statistics computed", "level": "expert"},
    {"name": "raw_compute_statistics", "suffix": "STAT0:ComputeStatistics", "type": "bit", "label": "raw statistics computed", "level": "expert"},
    {"name": "cam1_counter", "suffix": "cam1:ArrayCounter_RBV", "type": "counter", "label": "camera frames", "level": "expert"},
    {"name": "stat_counter", "suffix": "STAT:ArrayCounter_RBV", "type": "counter", "label": "statistics frames", "level": "expert"},
    {"name": "stat0_counter", "suffix": "STAT0:ArrayCounter_RBV", "type": "counter", "label": "raw statistics frames", "level": "expert"},
    {"name": "image_counter", "suffix": "MJPG1:ArrayCounter_RBV", "type": "counter", "label": "image frames", "level": "expert"},
    {"name": "crosshair1_use", "suffix": "OVER1:1:Use_RBV", "type": "bit", "label": "crosshair 1 shown", "writable": true, "write": "OVER1:1:Use"},
    {"name": "crosshair1_x", "suffix": "OVER1:1:CenterX_RBV", "type": "setpoint", "label": "crosshair 1 x", "writable": true, "write": "OVER1:1:CenterX", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair1_y", "suffix": "OVER1:1:CenterY_RBV", "type": "setpoint", "label": "crosshair 1 y", "writable": true, "write": "OVER1:1:CenterY", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair1_sx", "suffix": "OVER1:1:SizeX_RBV", "type": "setpoint", "label": "crosshair 1 width", "writable": true, "write": "OVER1:1:SizeX", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair1_sy", "suffix": "OVER1:1:SizeY_RBV", "type": "setpoint", "label": "crosshair 1 height", "writable": true, "write": "OVER1:1:SizeY", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair1_r", "suffix": "OVER1:1:Red_RBV", "type": "setpoint", "label": "crosshair 1 red", "writable": true, "write": "OVER1:1:Red", "level": "expert", "limits": [0, 255], "integer": true},
    {"name": "crosshair1_g", "suffix": "OVER1:1:Green_RBV", "type": "setpoint", "label": "crosshair 1 green", "writable": true, "write": "OVER1:1:Green", "level": "expert", "limits": [0, 255], "integer": true},
    {"name": "crosshair1_b", "suffix": "OVER1:1:Blue_RBV", "type": "setpoint", "label": "crosshair 1 blue", "writable": true, "write": "OVER1:1:Blue", "level": "expert", "limits": [0, 255], "integer": true},
    {"name": "crosshair1_name", "suffix": "OVER1:1:Name_RBV", "type": "setpoint", "label": "crosshair 1 name", "writable": true, "write": "OVER1:1:Name", "text": "string"},
    {"name": "crosshair1_shape", "suffix": "OVER1:1:Shape_RBV", "type": "enum", "label": "crosshair 1 shape", "writable": true, "write": "OVER1:1:Shape", "choices": ["Cross", "Rectangle"]},
    {"name": "crosshair2_use", "suffix": "OVER1:2:Use_RBV", "type": "bit", "label": "crosshair 2 shown", "writable": true, "write": "OVER1:2:Use"},
    {"name": "crosshair2_x", "suffix": "OVER1:2:CenterX_RBV", "type": "setpoint", "label": "crosshair 2 x", "writable": true, "write": "OVER1:2:CenterX", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair2_y", "suffix": "OVER1:2:CenterY_RBV", "type": "setpoint", "label": "crosshair 2 y", "writable": true, "write": "OVER1:2:CenterY", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair2_sx", "suffix": "OVER1:2:SizeX_RBV", "type": "setpoint", "label": "crosshair 2 width", "writable": true, "write": "OVER1:2:SizeX", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair2_sy", "suffix": "OVER1:2:SizeY_RBV", "type": "setpoint", "label": "crosshair 2 height", "writable": true, "write": "OVER1:2:SizeY", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "crosshair2_r", "suffix": "OVER1:2:Red_RBV", "type": "setpoint", "label": "crosshair 2 red", "writable": true, "write": "OVER1:2:Red", "level": "expert", "limits": [0, 255], "integer": true},
    {"name": "crosshair2_g", "suffix": "OVER1:2:Green_RBV", "type": "setpoint", "label": "crosshair 2 green", "writable": true, "write": "OVER1:2:Green", "level": "expert", "limits": [0, 255], "integer": true},
    {"name": "crosshair2_b", "suffix": "OVER1:2:Blue_RBV", "type": "setpoint", "label": "crosshair 2 blue", "writable": true, "write": "OVER1:2:Blue", "level": "expert", "limits": [0, 255], "integer": true},
    {"name": "crosshair2_name", "suffix": "OVER1:2:Name_RBV", "type": "setpoint", "label": "crosshair 2 name", "writable": true, "write": "OVER1:2:Name", "text": "string"},
    {"name": "crosshair2_shape", "suffix": "OVER1:2:Shape_RBV", "type": "enum", "label": "crosshair 2 shape", "writable": true, "write": "OVER1:2:Shape", "choices": ["Cross", "Rectangle"]},
    {"name": "roi_minx", "suffix": "ROI1:MinX_RBV", "type": "setpoint", "label": "analysis ROI x", "writable": true, "write": "ROI1:MinX", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "roi_miny", "suffix": "ROI1:MinY_RBV", "type": "setpoint", "label": "analysis ROI y", "writable": true, "write": "ROI1:MinY", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "roi_sizex", "suffix": "ROI1:SizeX_RBV", "type": "setpoint", "label": "analysis ROI width", "writable": true, "write": "ROI1:SizeX", "limits": [1, 65535], "integer": true, "units": "px"},
    {"name": "roi_sizey", "suffix": "ROI1:SizeY_RBV", "type": "setpoint", "label": "analysis ROI height", "writable": true, "write": "ROI1:SizeY", "limits": [1, 65535], "integer": true, "units": "px"},
    {"name": "roi_binx", "suffix": "ROI1:BinX_RBV", "type": "readback", "label": "analysis ROI bin x", "level": "expert"},
    {"name": "roi_biny", "suffix": "ROI1:BinY_RBV", "type": "readback", "label": "analysis ROI bin y", "level": "expert"},
    {"name": "roi_revx", "suffix": "ROI1:ReverseX_RBV", "type": "bit", "label": "analysis ROI reversed x", "level": "expert"},
    {"name": "roi_revy", "suffix": "ROI1:ReverseY_RBV", "type": "bit", "label": "analysis ROI reversed y", "level": "expert"},
    {"name": "width", "suffix": "MJPG1:ArraySize0_RBV", "type": "readback", "label": "image width", "units": "px"},
    {"name": "height", "suffix": "MJPG1:ArraySize1_RBV", "type": "readback", "label": "image height", "units": "px"},
    {"name": "background_on", "suffix": "PROC1:EnableBackground_RBV", "type": "bit", "label": "background subtracted", "writable": true, "write": "PROC1:EnableBackground"},
    {"name": "background_valid", "suffix": "PROC1:ValidBackground_RBV", "type": "bit", "label": "background valid"},
    {"name": "background_saving", "suffix": "PROC1:SaveBackground_RBV", "type": "command", "label": "grab background", "writable": true, "write": "PROC1:SaveBackground"},
    {"name": "transform", "suffix": "TRANS1:Type", "type": "enum", "label": "rotate / flip", "writable": true, "choices": ["None", "Rot90", "Rot180", "Rot270", "Mirror", "Rot90Mirror", "Rot180Mirror", "Rot270Mirror"]},
    {"name": "profile_size_x", "suffix": "STAT:ProfileSizeX_RBV", "type": "readback", "label": "profile length x", "level": "expert"},
    {"name": "profile_size_y", "suffix": "STAT:ProfileSizeY_RBV", "type": "readback", "label": "profile length y", "level": "expert"},
    {"name": "hist_min", "suffix": "STAT:HistMin_RBV", "type": "readback", "label": "histogram minimum", "level": "expert"},
    {"name": "hist_max", "suffix": "STAT:HistMax_RBV", "type": "readback", "label": "histogram maximum", "level": "expert"},
    {"name": "cursor_x", "suffix": "STAT:CursorX_RBV", "type": "setpoint", "label": "lineout cursor x", "writable": true, "write": "STAT:CursorX", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "cursor_y", "suffix": "STAT:CursorY_RBV", "type": "setpoint", "label": "lineout cursor y", "writable": true, "write": "STAT:CursorY", "limits": [0, 65535], "integer": true, "units": "px"},
    {"name": "profiles_on", "suffix": "STAT:ComputeProfiles", "type": "bit", "label": "profiles computed", "level": "expert"},
    {"name": "histogram_on", "suffix": "STAT:ComputeHistogram", "type": "bit", "label": "histogram computed", "level": "expert"},
    {"name": "profile_x", "suffix": "STAT:ProfileAverageX_RBV", "type": "array", "label": "profile x"},
    {"name": "profile_y", "suffix": "STAT:ProfileAverageY_RBV", "type": "array", "label": "profile y"},
    {"name": "cursor_profile_x", "suffix": "STAT:ProfileCursorX_RBV", "type": "array", "label": "cursor lineout x"},
    {"name": "cursor_profile_y", "suffix": "STAT:ProfileCursorY_RBV", "type": "array", "label": "cursor lineout y"},
    {"name": "histogram", "suffix": "STAT:Histogram_RBV", "type": "array", "label": "histogram"},
    {"name": "image", "suffix": "MJPG1:JPG_URL_RBV", "type": "image", "label": "image"},
    {"name": "lock", "suffix": "RUN:Lock", "type": "enum", "label": "run lock", "archive": true},
    {"name": "owner", "suffix": "RUN:Owner", "type": "readback", "label": "run lock owner", "text": "string"},
    {"name": "capture", "suffix": "HDF1:Capture_RBV", "type": "enum", "label": "file capture"},
    {"name": "period", "suffix": "cam1:AcquirePeriod_RBV", "type": "setpoint", "label": "acquire period", "writable": true, "write": "cam1:AcquirePeriod", "units": "s", "limits": [0, 3600], "locked": true, "archive": true},
    {"name": "frame_rate", "suffix": "cam1:FrameRate_RBV", "type": "readback", "label": "camera frame rate", "units": "Hz", "archive": true},
    {"name": "gain", "suffix": "cam1:Gain_RBV", "type": "setpoint", "label": "gain", "writable": true, "write": "cam1:Gain", "limits": [0, 100], "locked": true, "archive": true},
    {"name": "trigger_mode", "suffix": "cam1:TriggerMode_RBV", "type": "enum", "label": "trigger mode", "writable": true, "write": "cam1:TriggerMode", "choices": ["Off", "On"], "locked": true, "archive": true},
    {"name": "trigger_source", "suffix": "cam1:TriggerSource_RBV", "type": "enum", "label": "trigger source", "archive": true},
    {"name": "acquire", "suffix": "cam1:Acquire_RBV", "type": "enum", "label": "acquire", "writable": true, "write": "cam1:Acquire", "settled_by": "acquire", "integer": true, "limits": [0, 1], "locked": true, "archive": true},
    {"name": "min_x", "suffix": "cam1:MinX_RBV", "type": "setpoint", "label": "camera ROI x", "writable": true, "write": "cam1:MinX", "level": "expert", "limits": [0, 65535], "integer": true, "units": "px", "locked": true, "archive": true},
    {"name": "min_y", "suffix": "cam1:MinY_RBV", "type": "setpoint", "label": "camera ROI y", "writable": true, "write": "cam1:MinY", "level": "expert", "limits": [0, 65535], "integer": true, "units": "px", "locked": true, "archive": true},
    {"name": "size_x", "suffix": "cam1:SizeX_RBV", "type": "setpoint", "label": "camera ROI width", "writable": true, "write": "cam1:SizeX", "level": "expert", "limits": [1, 65535], "integer": true, "units": "px", "locked": true, "archive": true},
    {"name": "size_y", "suffix": "cam1:SizeY_RBV", "type": "setpoint", "label": "camera ROI height", "writable": true, "write": "cam1:SizeY", "level": "expert", "limits": [1, 65535], "integer": true, "units": "px", "locked": true, "archive": true},
    {"name": "max_x", "suffix": "cam1:MaxSizeX_RBV", "type": "readback", "label": "sensor width", "units": "px", "level": "expert"},
    {"name": "max_y", "suffix": "cam1:MaxSizeY_RBV", "type": "readback", "label": "sensor height", "units": "px", "level": "expert"}
  ]
}
