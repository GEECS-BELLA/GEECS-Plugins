  </widget>

  <widget type="textupdate" version="2.0.0">
    <name>version_6_80</name>
    <pv_name>pva://undulator:pvagateway:192_168_6_80:version</pv_name>
    <x>170</x><y>155</y><width>150</width><height>20</height>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>heartbeat_6_80</name>
    <pv_name>pva://undulator:pvagateway:192_168_6_80:heartbeat</pv_name>
    <x>330</x><y>155</y><width>100</width><height>20</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>restart_6_80</name>
    <actions>
      <action type="write_pv">
        <pv_name>pva://undulator:pvagateway:192_168_6_80:restart</pv_name>
        <value>1</value>
        <description>Restart</description>
      </action>
    </actions>
    <text>restart</text>
    <x>440</x><y>155</y><width>80</width><height>20</height>
    <tooltip>Relaunch this instance (reinstalls from the source clone)</tooltip>
    <confirm_dialog>true</confirm_dialog>
    <confirm_message>Restart the PVA gateway on 192.168.6.80?</confirm_message>
  </widget>

