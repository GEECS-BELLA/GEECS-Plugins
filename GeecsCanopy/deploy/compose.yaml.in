# GeecsCanopy - docker compose TEMPLATE, rendered by deploy/render_conf.sh and
# installed as /etc/geecs/canopy/compose.yaml (never edit the installed copy).
# @PLACEHOLDER@ = render time; ${VARIABLE} = compose at `up`, from site.env;
# secrets reach the containers through env_file only, never interpolated.
# Host networking throughout (CA needs UDP); Canopy's own Postgres and Redis
# on loopback ports 5433 / 6380 (fleet constants). DEPLOYMENT.md section 1.
x-logging: &logging
  driver: json-file
  options: {max-size: "50m", max-file: "3"}

x-app: &app
  image: geecs-canopy:@CANOPY_COMMIT@
  build:
    context: "@BUILD_CONTEXT@"
    dockerfile: GeecsCanopy/deploy/Dockerfile
    args: {CANOPY_IMAGE: "@CANOPY_IMAGE@"}
  network_mode: host
  # systemd supervises (Restart=on-failure on the unit); compose must not.
  restart: "no"
  logging: *logging
  env_file: /etc/geecs/canopy/secrets.env
  environment: &app-env
    # Without this Canopy serves synthetic sine waves and still passes /health.
    CANOPY_EPICS__BACKEND: epics
    EPICS_CA_ADDR_LIST: "${EPICS_CA_ADDR_LIST}"
    EPICS_CA_AUTO_ADDR_LIST: "${EPICS_CA_AUTO_ADDR_LIST}"
    TZ: "${TZ}"
  depends_on:
    postgres: {condition: service_healthy}
    redis: {condition: service_healthy}

services:
  api:
    <<: *app
    # The wrapper: Canopy + the GEECS device module at /geecs. Rollback when its
    # self-test refuses to start: canopy.main:app with the previous pin (DEPLOYMENT.md 5).
    command: ["uvicorn", "geecs_canopy.app:app", "--host", "${GEECS_CANOPY_BIND}",
              "--port", "${GEECS_CANOPY_PORT}", "--root-path", "${GEECS_CANOPY_ROOT_PATH}"]
    environment:
      <<: *app-env
      GEECS_CANOPY_EXPERIMENT: "${GEECS_EXPERIMENT}"
      GEECS_CANOPY_CONFIGS_ROOT: /opt/geecs-configs
      GEECS_CANOPY_STATE_DIR: /var/lib/geecs-canopy-module
      GEECS_CANOPY_DB: "${GEECS_CANOPY_DB}"   # off: neither the directory nor the module reads the DB
      # Squirrel, as the module (and `geecs-canopy squirrel-sync`) reaches it: this api
      # itself, over loopback as the healthcheck does (BIND may be 0.0.0.0).
      GEECS_CANOPY_SQUIRREL_URL: "http://127.0.0.1:${GEECS_CANOPY_PORT}"
      CANOPY_RACCOON__DIRECTORY__TYPE: geecs_canopy.directory:GeecsDirectoryAdapter
      CANOPY_RACCOON__DIRECTORY__EXTRAS__EXPERIMENT: "${GEECS_EXPERIMENT}"
      CANOPY_RACCOON__DIRECTORY__EXTRAS__CONFIGS_ROOT: /opt/geecs-configs
      CANOPY_RACCOON__DIRECTORY__EXTRAS__DB: "${GEECS_CANOPY_DB}"
    volumes:
      - "${GEECS_CONFIGS_ROOT}:/opt/geecs-configs:ro"
      - /var/lib/geecs-canopy/module:/var/lib/geecs-canopy-module   # the journal
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:${GEECS_CANOPY_PORT}/health')\""]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  worker:
    <<: *app
    command: ["arq", "canopy.worker.WorkerSettings"]
    healthcheck: {disable: true}
    deploy: {replicas: 2}

  postgres:
    image: postgres:16-alpine
    network_mode: host
    restart: "no"
    logging: *logging
    user: "@SERVICE_UID@:@SERVICE_GID@"
    env_file: /etc/geecs/canopy/secrets.env
    command: ["postgres", "-c", "listen_addresses=127.0.0.1", "-c", "port=5433"]
    volumes:
      - /var/lib/geecs-canopy/pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 5433 -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    network_mode: host
    restart: "no"
    logging: *logging
    env_file: /etc/geecs/canopy/secrets.env
    command: ["sh", "-c", "exec redis-server --bind 127.0.0.1 --port 6380 --save '' --appendonly no --requirepass \"$$REDIS_PASSWORD\""]
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -p 6380 --no-auth-warning -a \"$$REDIS_PASSWORD\" ping"]
      interval: 5s
      timeout: 5s
      retries: 10
