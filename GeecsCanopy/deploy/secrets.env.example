# GeecsCanopy secrets - installed by root as /etc/geecs/canopy/secrets.env,
# mode 0600, owned by the service account (docker compose reads it as that
# user). Placeholders only: generate each value on the host
# (`openssl rand -hex 32`), never commit or paste one. Single-line values.

# Canopy's own Postgres and Redis (this compose project's, loopback only).
POSTGRES_USER=canopy
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=canopy
REDIS_PASSWORD=<redis-password>
CANOPY_DATABASE_URL=postgresql+asyncpg://canopy:<postgres-password>@127.0.0.1:5433/canopy
CANOPY_REDIS_URL=redis://:<redis-password>@127.0.0.1:6380/0

# The two env-layer keys (DEPLOYMENT.md "Keys"): the display key is read-only,
# the ops key admin. Condition (a): no operator or front-end key carries write.
# Every other key is minted into Postgres with scripts/create_key.py.
CANOPY_API_KEYS=<display-read-token>:read@*,<ops-admin-token>:admin@*

# The transitional gateway source's read-only MySQL user (DEPLOYMENT.md
# "The GEECS DB"). Omit, with GEECS_CANOPY_DB=off in site.env, on a site
# without one.
GEECS_CANOPY_DB_URL=mysql://<readonly-user>:<password>@<db-host>:3306/<database>
