# GEECS → EPICS Channel Access gateway — systemd unit TEMPLATE.
#
# Do not copy this file to /etc/systemd/system by hand. Render it from the
# host's site.env with `deploy/render_units.sh` (or `deploy/bootstrap_host.sh`,
# which does everything up to the root steps) — see
# docs/platform/site_profile.md. Two kinds of holes:
#   @PLACEHOLDER@   filled at render time (paths + identity: systemd cannot
#                   expand variables in User=, WorkingDirectory=, Environment=,
#                   or the executable path);
#   ${VARIABLE}     read from site.env at start via EnvironmentFile= (only
#                   valid in command arguments).
# Site-specific values (experiment, serving interface, TZ) live in site.env,
# never here; the placeholders carry the generic service-account shape only.
#
# Upgrade / DB-resync (a restart IS both — config rebuilds live from the DB):
#   git -C <checkout> pull && poetry install && sudo systemctl restart geecs-ca-gateway
# Remote restart with no shell: a CA put to <experiment>:cagateway:restart
# (exit code 86 → relaunch, see below).
#
# See deploy/README.md and DEPLOYMENT.md.

[Unit]
Description=GEECS to EPICS Channel Access gateway
# The gateway reads the GEECS DB at startup. mysql.service is ordering only
# (systemd ignores a unit that does not exist — a remote DB or a mariadb
# unit name needs no edit); Restart=on-failure retries until the DB answers.
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
# Poetry resolves its cache/venvs under $HOME; systemd does not always set it.
Environment=HOME=@SERVICE_HOME@
# The host's site profile: GEECS_EXPERIMENT, EPICS_CAS_INTF_ADDR_LIST /
# EPICS_CAS_BEACON_ADDR_LIST (serve CA only on the lab interface — write-safety
# residual, there is no CA-level auth), TZ.
EnvironmentFile=@SITE_ENV@
# The gateway's OWN clone — never one another service runs from.
WorkingDirectory=@CHECKOUT_ROOT@/gateway-checkout/GeecsCAGateway
ExecStart=@POETRY@ run python -m geecs_ca_gateway --experiment ${GEECS_EXPERIMENT}
Restart=on-failure
RestartSec=10
# Remote restart: a CA put to <experiment>:cagateway:restart makes the gateway
# exit with code 86, which systemd treats as "relaunch" (clean, not a failure).
# This is also how the served set resyncs after a GEECS DB edit — no SSH needed.
SuccessExitStatus=86
RestartForceExitStatus=86
SyslogIdentifier=geecs-ca-gateway

[Install]
WantedBy=multi-user.target
