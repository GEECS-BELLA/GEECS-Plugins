# site.env — the host half of the GEECS site profile. ONE file per service
# host, installed at /etc/geecs/site.env (see docs/platform/site_profile.md).
#
# Every facility-specific value a service host needs lives here and nowhere
# else: the unit files read it through EnvironmentFile=, and
# deploy/bootstrap_host.sh renders the service account's config.ini from it.
# The client half of the profile is ~/.config/geecs_python_api/config.ini on
# every client machine (docs/tutorials/getting_started.md).
#
# This file is the worked example for the HTU/Undulator reference deployment
# (the central lab server serving CA, Tiled, and the DB on 192.168.6.14).
# Copy it, change the values, keep the keys (the one exception: a site without
# an Archiver Appliance deletes the three GEECS_ARCHIVER_* keys, see below).
#
# Syntax is systemd EnvironmentFile syntax: plain KEY=VALUE, no shell
# expansion, quote values that contain spaces, and comments ONLY on their
# own lines — systemd does not strip a trailing "# comment", it becomes part
# of the value.
#
# Two kinds of keys:
#   * runtime values — exported into every service process by systemd; the
#     env-var NAMES are the ones the services and EPICS actually read, so
#     nothing is re-mapped. Every one of them is REQUIRED: render_units.sh
#     and bootstrap_host.sh refuse a profile that omits one, because the
#     service would otherwise start on its built-in default (UTC, EPICS
#     broadcast) instead of the site's value;
#   * install-time values (GEECS_SERVICE_*, GEECS_CHECKOUT_ROOT, GEECS_POETRY,
#     GEECS_REPO_URL, GEECS_*_ROOT/URI/HOST) — consumed by render_units.sh and
#     bootstrap_host.sh to fill the @PLACEHOLDER@ holes in the unit templates
#     and to write config.ini. They are harmless in the process environment.

# ---- identity -----------------------------------------------------------
# Short tag for logs and docs; not a PV namespace.
GEECS_SITE=htu
# GEECS experiment name = the PV namespace prefix.
GEECS_EXPERIMENT=Undulator
# Same value; the queueserver startup profile reads this name (it also
# falls back to config.ini [Experiment] expt).
QS_EXPERIMENT=Undulator

# ---- service account + layout (install-time) ----------------------------
# The unprivileged account every unit runs as, and its home (poetry keys
# venvs under it; config.ini lives in it).
GEECS_SERVICE_USER=geecs
GEECS_SERVICE_HOME=/home/geecs
# Per-service clones live here: <root>/gateway-checkout, <root>/portal-checkout,
# <root>/qs-checkout (shared by the queueserver and, as its install source,
# the MCP server), <root>/archiver-checkout (the archiver's CLI and conf
# templates; its unit runs a container and never reads it),
# <root>/control-room-checkout (the Control Room). /opt/geecs is the same
# layout with a different root.
GEECS_CHECKOUT_ROOT=/home/geecs
# Optional: where experiment INSTANCES' clones live (<unit>@<Instance>,
# deploy/experiments.env.example). Unset = the main clones above. Set it when
# an instance must run code the main clones are not on.
# GEECS_INSTANCE_CHECKOUT_ROOT=/home/geecs/instances
# ABSOLUTE poetry path: systemd's service PATH omits ~/.local/bin.
GEECS_POETRY=/home/geecs/.local/bin/poetry
GEECS_REPO_URL=https://github.com/GEECS-BELLA/GEECS-Plugins.git

# ---- EPICS (runtime; the names EPICS itself reads) ----------------------
# Clients: where the CA servers are — the gateway, then each native IOC host
# (geecs-epics). An IOC on its own CA port is named host:port. Always paired
# with AUTO_ADDR_LIST=NO so CA never also broadcasts on the local subnet.
EPICS_CA_ADDR_LIST="192.168.6.14 192.168.7.166 192.168.7.166:5066"
EPICS_CA_AUTO_ADDR_LIST=NO
# The gateway (a CA server): serve on the lab interface only.
EPICS_CAS_INTF_ADDR_LIST=192.168.6.14
EPICS_CAS_BEACON_ADDR_LIST=192.168.6.255

# ---- time (runtime) -----------------------------------------------------
# Daily scan folders (YY_MMDD) are named by the scanner host's LOCAL date;
# every service that resolves dates must agree with the scanner. Never
# leave a server on UTC by accident.
TZ=America/Los_Angeles

# ---- fleet endpoints (install-time; rendered into config.ini) -----------
GEECS_TILED_URI=http://192.168.6.14:8000
# No key for the Tiled writer (geecs-tiled-writer, GeecsBluesky 0.103.0):
# it reads the catalog from the rendered config.ini above, and its spool
# directory — /var/lib/geecs-tiled-writer, the units' StateDirectory, set
# explicitly as GEECS_TILED_WRITER_STATE in the qserver, writer and scanner
# units — is the same path on every host, so it is not a site value (the
# logbook's /var/lib/geecs-logbook is the precedent).
# The queueserver worker host (RE Manager :60615, document stream :5568).
GEECS_QSERVER_HOST=192.168.6.14
# The document stream as seen from THIS host (the doc-stream consumers' addr).
GEECS_QS_DOC_ADDR=localhost:5568
# The host serving the web scanner (:8300), the Data Portal (:8200) and the
# logbook (:8400), as geecs-mcp reaches them (install-time): rendered into the
# service account's config.ini [mcp] scanner_url / portal_url / logbook_url.
# Ports are fleet constants. A site without the MCP deletes the key: the
# bootstrap then deploys no geecs-mcp (`--only mcp` fails on the missing key).
# On the reference deployment the services share the worker box.
GEECS_SERVICES_HOST=192.168.6.14
# The camera servers running a PVA image gateway (config.ini [pva] addr_list:
# the deployed fleet the probe searches) and, of those, the boxes whose
# gateway serves the file plugin (config.ini [pva] file_plugin_addr_list:
# the worker makes their cameras plugin-backed and searches these hosts
# for the plugin PVs). Space-separated; empty = no PVA gateways / no
# plugin-backed camera on this site. HTU: the same nine boxes for both.
GEECS_PVA_ADDR_LIST="192.168.6.80 192.168.6.100 192.168.7.161 192.168.7.162 192.168.7.163 192.168.7.164 192.168.8.197 192.168.8.199 192.168.8.201"
GEECS_PVA_FILE_PLUGIN_ADDR_LIST="192.168.6.80 192.168.6.100 192.168.7.161 192.168.7.162 192.168.7.163 192.168.7.164 192.168.8.197 192.168.8.199 192.168.8.201"

# ---- data share (install-time; rendered into config.ini) ----------------
# Where the GEECS data share is mounted on this host. The configs repo is
# consumed from the share too (LabVIEW reads the same files) — typically a
# Windows-authored checkout: set core.autocrlf=true on it before pulling
# from Linux (fleet map, bootstrap gotcha 5). Quote paths with spaces.
GEECS_DATA_ROOT=/mnt/hdna2/data
GEECS_CONFIGS_ROOT="/mnt/hdna2/software/control-all-loasis/HTU/Active Version/GEECS-Plugins-Configs"
# Optional flags appended to the data portal's command line (whitespace-
# split; leave empty or omit for none). --config-editor mounts the analysis
# config editor at /configs — a WRITE verb into the configs checkout above;
# set it where operators tune diagnostics from the browser, not on a
# read-only viewer. --logbook-url is the logbook service's base URL (its
# own unit, geecs-logbook, port 8400): the run page links each scan to its
# card there; a path (/log) means "same origin, behind the front door".
# Omit it and the portal shows no link.
GEECS_PORTAL_EXTRA_ARGS=--config-editor --logbook-url http://192.168.6.14:8400
# Optional flags appended to the logbook's command line (whitespace-split;
# empty or omitted = none). The entries go to the unit's StateDirectory
# (/var/lib/geecs-logbook/logbook.db — the same on every host, so not a site
# value) and are mirrored as markdown into each day's logbook/ folder on the
# share; add --notes-db PATH here only to keep the file elsewhere.
GEECS_LOGBOOK_EXTRA_ARGS=
# Memory ceiling for the portal service (install-time; rendered into the
# unit's MemoryHigh=/MemoryMax=). systemd sizes: 3G, 4096M, 25%. Above
# HIGH the portal is throttled and reclaimed; at MAX it is killed and
# restarted — so a runaway portal evicts itself before the kernel picks a
# victim on the shared box (#834). The unit also sets MemorySwapMax=0, so
# MAX is reached and enforced rather than absorbed by swap. 3G/4G suit
# the 16 GB reference host; size for the host's RAM and the other
# services on it. Portal analysis runs (the Analysis tab) execute in this
# process, so on a large-memory host give it real room — e.g. 48G/64G on
# a 128 GB box.
GEECS_PORTAL_MEMORY_HIGH=3G
GEECS_PORTAL_MEMORY_MAX=4G

# ---- archiver (GeecsArchiver: upstream's Archiver Appliance, a CA client of
# the gateway, in its official container under geecs-archiver) --------------
# A site WITHOUT an appliance deletes these three keys: the bootstrap then
# skips the archiver (the PVA "empty = none" precedent) and nothing else
# changes; `--only archiver` on such a site fails on the missing key.
# The appliance's address as every client reaches it (install-time): rendered
# into appliances.xml and into the service account's config.ini [archiver] url;
# the Phoebus Data Browser datasource is pbraw://<this>:17665/retrieval. Port
# 17665 is a fleet constant. On the reference deployment the appliance shares
# the central box.
GEECS_ARCHIVER_HOST=192.168.6.14
# Where the archive lives on this host (install-time): <root>/sts (short-term,
# hourly files; a tmpfs symlink is upstream's recommendation, local SSD is
# fine) and <root>/lts (long-term, yearly files) on local disk — never a live
# store on the SMB share. Sizing: GeecsArchiver/PLAN.md § 5.
GEECS_ARCHIVER_DATA_ROOT=/srv/geecs-archiver
# JVM options for the appliance's Tomcat (runtime; read by docker compose at
# start). -Xmx is the heap ceiling: 1g on a shared 16 GB host, 2g on a box of
# its own; the engine is built for millions of PVs, a few thousand need little.
GEECS_ARCHIVER_JAVA_OPTS=-Xmx1g

# ---- canopy (GeecsCanopy: SLAC's Canopy display backend in a derived image,
# its own Postgres + Redis, under geecs-canopy; runtime, read by docker compose
# at `up`) ------------------------------------------------------------------
# Secrets never live here (this file is world-readable): the Postgres/Redis
# passwords, Canopy's two env keys and the read-only DB user are in
# /etc/geecs/canopy/secrets.env (GeecsCanopy/deploy/secrets.env.example). The
# image pin is a fleet constant (GeecsCanopy/geecs_canopy/pin.py), not a site
# value. Experiment and configs root are GEECS_EXPERIMENT / GEECS_CONFIGS_ROOT.
# Where the api listens (host networking): 127.0.0.1 behind a front door on
# the same host, else 0.0.0.0 (never this host's address alone: the healthcheck
# and the module's Squirrel URL reach it over loopback). Without a front door
# the root path is empty, as every other surface is served on its own port.
GEECS_CANOPY_BIND=127.0.0.1
GEECS_CANOPY_PORT=8600
# The front door's prefix (uvicorn --root-path); the WebSocket is then
# <prefix>/hare/v1/ws/pvs. Empty = served at /.
GEECS_CANOPY_ROOT_PATH=/canopy
# The directory's transitional gateway source (LabVIEW devices from the GEECS
# DB, read-only user): on | off.
GEECS_CANOPY_DB=on

# ---- control room (GeecsControlRoom: the Control Room and the screens, over
# Canopy; read by the process at start) -------------------------------------
# The display's Canopy READ key is a secret: /etc/geecs/control-room/secrets.env
# (GEECS_CONTROL_ROOM_READ_KEY=...), never here. Experiment and configs root
# are GEECS_EXPERIMENT / GEECS_CONFIGS_ROOT.
GEECS_CONTROL_ROOM_BIND=127.0.0.1
GEECS_CONTROL_ROOM_PORT=8700
# Canopy as this process reaches it (its bind and port, no prefix: uvicorn's
# --root-path adds it), and as the browser does (the front door's prefix;
# Hare's WebSocket is <browser url>/hare/v1/ws/pvs). Empty browser url = the first.
# Without a front door: BIND=0.0.0.0 and the browser url http://<this host>:<Canopy's port>.
GEECS_CONTROL_ROOM_CANOPY_URL=http://127.0.0.1:8600
GEECS_CONTROL_ROOM_CANOPY_BROWSER_URL=/canopy
# Flags appended to the command line (whitespace-split): --root-path /room
# for a prefix-preserving front door.
GEECS_CONTROL_ROOM_EXTRA_ARGS=

# ---- scanner (runtime) ---------------------------------------------------
# Flags appended to the web scanner's command line (whitespace-split).
# --root-path /scan when the front door mounts it under a prefix and does
# not send X-Forwarded-Prefix. Empty = serve at root on :8300.
# e.g. --portal-url http://${GEECS_SERVICES_HOST}:8200 (the rail's scan links open the portal's run pages)
GEECS_SCANNER_EXTRA_ARGS=
