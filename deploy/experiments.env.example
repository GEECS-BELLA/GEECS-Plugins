# experiments.env.example — one experiment INSTANCE's values, beside site.env.
#
# Installed as /etc/geecs/experiments/<Instance>.env (root-owned, 0644) and read
# by the instance template units (geecs-ca-gateway@, geecs-qserver@,
# geecs-qserver-ready@, geecs-tiled-writer@, geecs-scanner@, geecs-logbook@)
# AFTER /etc/geecs/site.env, so every key here overrides the site's value for
# that instance only. Same parsing as site.env: KEY=VALUE, no shell
# expansion, no trailing comments. The main experiment keeps its
# non-templated units and site.env alone; it has no file here.
#
# <Instance> is a slug (letters, digits, '-', '_'): the unit instance name,
# the state directory /var/lib/geecs-experiments/<Instance>/, and the Redis
# prefix. The DB experiment name may differ and may contain spaces.
#
# Ports come from the instance's SLOT N (1..9; the main experiment is slot 0
# = the stock ports):
#   CA server 5064+100N | 0MQ control 60615+100N | 0MQ info 60625+100N
#   doc proxy in/out 5567+100N / 5568+100N | scanner 8300+10N | logbook 8400+10N
# Every value below is the worked example for slot 1; @...@ marks a site value
# to fill in (deploy/experiment.sh writes this file from the example).

GEECS_INSTANCE=PulsedWire
GEECS_INSTANCE_SLOT=1

# The GEECS DB experiment (expt.name) this instance serves: the worker's
# device namespace, the gateway's roster and PV prefix, the scanner's and
# logbook's experiment. Both keys, equal (site.env's rule).
GEECS_EXPERIMENT=@DB_EXPERIMENT@
QS_EXPERIMENT=@DB_EXPERIMENT@

# --- the instance's CA gateway (geecs-ca-gateway@) ---
# Its CA server port (handed to the gateway process alone as
# EPICS_CA_SERVER_PORT; never set that key here).
GEECS_CA_SERVER_PORT=5164
# The interface it serves on and where it beacons: THIS host's, which need
# not be the main gateway's.
EPICS_CAS_INTF_ADDR_LIST=@THIS_HOST_ADDRESS@
EPICS_CAS_BEACON_ADDR_LIST=@THIS_HOST_BROADCAST@

# --- the worker's CA clients (geecs-qserver@) ---
# The instance's own gateway first, with its port; then any native IOC hosts
# the experiment drives (host or host:port, space-separated).
EPICS_CA_ADDR_LIST="@THIS_HOST_ADDRESS@:5164"
EPICS_CA_AUTO_ADDR_LIST=NO

# --- the RE Manager (geecs-qserver@, geecs-qserver-ready@) ---
QSERVER_ZMQ_CONTROL_ADDRESS_FOR_SERVER=tcp://*:60715
QSERVER_ZMQ_INFO_ADDRESS_FOR_SERVER=tcp://*:60725
QS_REDIS_PREFIX=qs_PulsedWire
QS_DOC_PROXY_IN=5667
QS_DOC_PROXY_OUT=5668
QS_DOC_PUBLISH_ADDR=localhost:5667

# --- the clients of this manager ---
# geecs-qserver-ready@ (the readiness key, as in site.env):
QS_CONTROL_ADDR=tcp://localhost:60715
# geecs-scanner@ (the queue client; names of their own, so the main scanner,
# which reads site.env, never picks one up):
QS_CLIENT_CONTROL_ADDR=tcp://localhost:60715
QS_CLIENT_INFO_ADDR=tcp://localhost:60725
QS_CLIENT_DOC_ADDR=localhost:5668

# --- the instance's web surfaces ---
GEECS_SCANNER_PORT=8310
GEECS_LOGBOOK_PORT=8410
