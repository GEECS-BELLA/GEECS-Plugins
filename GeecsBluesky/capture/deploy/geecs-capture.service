# GEECS central PVA capture daemon — systemd unit TEMPLATE.
#
# Do not copy this file to /etc/systemd/system by hand. Render it from the
# host's site.env with `deploy/render_units.sh` (or `deploy/bootstrap_host.sh`)
# — see docs/platform/site_profile.md. @PLACEHOLDER@ holes are filled at render
# time (paths + identity); ${VARIABLE} values come from site.env at start via
# EnvironmentFile= (valid only in command arguments).
#
# The daemon MUST run on the machine sharing the queueserver worker's
# filesystem view (the start doc's save paths and the liveness heartbeat both
# assume it) and runs from the SAME clone (qs-checkout) — co-location and
# co-versioning are a requirement of the capture design.

[Unit]
Description=GEECS PVA capture daemon (per-device frame stacks)
# Not a hard dependency: the daemon reconnects to the doc stream on its own,
# but ordering after the qserver keeps clean-boot logs tidy.
After=network-online.target geecs-qserver.service
Wants=network-online.target

[Service]
Type=exec
# Same account as the queueserver (shared filesystem view, shared config.ini).
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
# The host's site profile: GEECS_EXPERIMENT, GEECS_QS_DOC_ADDR (the document
# stream as seen from this host — localhost:5568 when the worker is local),
# EPICS addressing, TZ.
EnvironmentFile=@SITE_ENV@
WorkingDirectory=@CHECKOUT_ROOT@/qs-checkout/GeecsBluesky
# Poetry's ABSOLUTE path is required (systemd PATH omits ~/.local/bin).
ExecStart=@POETRY@ run geecs-capture-daemon --experiment ${GEECS_EXPERIMENT} --doc-addr ${GEECS_QS_DOC_ADDR}
Restart=on-failure
RestartSec=5
# Exit 2 = permanent misconfiguration (bad flags, no [qserver] config, no
# eligible cameras) — restarting cannot fix it, so don't loop forever.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
