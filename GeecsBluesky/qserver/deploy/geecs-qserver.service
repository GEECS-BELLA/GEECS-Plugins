# GEECS bluesky-queueserver RE Manager — systemd unit TEMPLATE.
#
# Do not copy this file to /etc/systemd/system by hand. Render it from the
# host's site.env with `deploy/render_units.sh` (or `deploy/bootstrap_host.sh`)
# — see docs/platform/site_profile.md. @PLACEHOLDER@ holes are filled at render
# time (paths + identity); ${VARIABLE} values come from site.env at start via
# EnvironmentFile= (valid only in command arguments).
#
# The queueserver and the capture daemon share qs-checkout by design
# (co-location and co-versioning are a requirement of the capture design);
# the MCP server bakes its venv from the same clone. See the fleet map's
# "one clone per service" section for why that is the only sharing allowed.

[Unit]
Description=GEECS Bluesky Queueserver RE Manager
# launch_re_manager.sh starts a loopback redis itself if none answers, so
# redis-server.service is ordering only, not a requirement.
After=network-online.target redis-server.service
Wants=network-online.target
# A running manager means READY (#793): pull in the readiness oneshot on
# every start (it orders itself After= this unit and is PartOf= it, so a
# restart here re-runs it; a plain stop/start here re-runs it through this
# Wants=). Enabling both units is still the documented install.
Wants=geecs-qserver-ready.service

[Service]
Type=exec
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
# The host's site profile: QS_EXPERIMENT (the startup profile's experiment;
# falls back to config.ini [Experiment] expt), EPICS_CA_ADDR_LIST +
# EPICS_CA_AUTO_ADDR_LIST=NO (the CA gateway, directed — without the NO, CA
# also broadcasts on the local subnet and a second CA server serving
# colliding names produces nondeterministic connects), TZ.
EnvironmentFile=@SITE_ENV@
WorkingDirectory=@CHECKOUT_ROOT@/qs-checkout/GeecsBluesky

# CurveZMQ control-plane key management is still an open design item (tracked
# in GEECS-Plugins issue #660). When that decision lands, the server private
# key goes in a root-only secrets file (EnvironmentFile=-/etc/geecs/secrets.env,
# mode 0600) — never in site.env (0644, world-readable) and never here.
# Environment="QSERVER_ZMQ_PRIVATE_KEY_FOR_SERVER="

# Poetry's ABSOLUTE path is required: systemd's service PATH omits
# ~/.local/bin, so a bare `env poetry` crash-loops with "No such file or
# directory" every RestartSec. The launch script derives the startup
# directory from its own location; QS_STARTUP_DIR overrides it.
ExecStart=@POETRY@ run @CHECKOUT_ROOT@/qs-checkout/GeecsBluesky/qserver/launch_re_manager.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
